{
  "channels": [
    {
      "address": "private-tasks.{taskId}",
      "channel": "taskStatus",
      "messages": [
        {
          "event": "TaskStatusChanged",
          "message": "taskStatusChanged"
        }
      ]
    },
    {
      "address": "private-users.{userId}",
      "channel": "userSession",
      "messages": []
    }
  ],
  "messages": [
    {
      "action": "receive",
      "channel": "private-tasks.{taskId}",
      "event": "TaskStatusChanged",
      "message": "taskStatusChanged",
      "operation": "receiveTaskStatusChanged",
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "state", "version", "occurred_at", "correlation_id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque Task identifier."
          },
          "state": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Increases by one on every persisted transition. Consumers must ignore versions older than the newest one seen."
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "correlation_id": {
            "type": "string",
            "description": "Correlation ID of the request that started the Task."
          }
        }
      },
      "payload_type": "TaskStatusChangedPayload"
    }
  ]
}
