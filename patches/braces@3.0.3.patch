diff --git a/node_modules/braces/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..1908e505cf5fa76a9bee396e70040a95845d4c64
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,21 @@
+'use strict';
+
+const MAX_DEPTH = 256;
+
+const assertNesting = depth => {
+  if (depth > MAX_DEPTH) {
+    throw new SyntaxError(`Brace nesting exceeds maximum depth (${MAX_DEPTH})`);
+  }
+};
+
+const assertDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (!node || !node.nodes) continue;
+    assertNesting(depth);
+    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+  }
+};
+
+module.exports = { assertDepth, assertNesting };
