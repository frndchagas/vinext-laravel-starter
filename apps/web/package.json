{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-13000}",
    "build": "vinext check && node node_modules/vite/bin/vite.js build",
    "start": "vinext start --port ${WEB_PORT:-13000}",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "bun check --no-script",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@tanstack/react-query": "5.104.5",
    "@vinext-laravel-starter/api-client": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "laravel-echo": "2.6.1",
    "lucide-react": "1.61.0",
    "pusher-js": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-sync-external-store": "1.7.0",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "jsdom": "30.1.3",
    "oxc-transform-react": "0.155.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
