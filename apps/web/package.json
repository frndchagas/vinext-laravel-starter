{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --hostname ${WEB_HOST:-127.0.0.1} --port ${WEB_PORT:-13000}",
    "build": "vinext check && vinext build",
    "start": "vinext start --port ${WEB_PORT:-13000}",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@tanstack/react-query": "5.101.4",
    "@vinext-laravel-starter/api-client": "workspace:*",
    "@vinext-laravel-starter/realtime-contract": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "laravel-echo": "2.4.0",
    "lucide-react": "1.33.0",
    "pusher-js": "8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "use-sync-external-store": "1.6.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "jsdom": "30.0.1",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
